__pycache__/
*.pyc
runs/
.venv/
.DS_Store

# event logs are participant data: keep the example, ignore real ones
logs/*.csv
!logs/EXAMPLE_*.csv

# Unity project. Library is a rebuildable cache and is enormous; Logs and UserSettings
# are per-machine. ProjectSettings and Packages ARE tracked: they define the project.
unity/Library/
unity/Logs/
unity/UserSettings/
unity/Temp/
unity/obj/
unity/Build/
unity/Builds/
unity/*.csproj
unity/*.sln

# Raw asset-pack download. The five models actually used are committed under
# unity/Assets/Furniture/Models; this 20 MB folder is not needed to run the study.
kenney_furniture-kit/

# Generated at runtime by serve-study.py
runs/web-data/
runs/study-cert.pem
runs/study-key.pem

# Unity native-build temp: machine-specific absolute paths baked in, never committed
unity/.utmp/

# Compiled builds never belong in the repo
*.app/
unity/*.app/
