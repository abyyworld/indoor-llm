<!--
  Keep the study's own code out of the managed stripper.

  The player deserializes scenes positionally: level0 carries no type tree, so the
  engine reads each MonoBehaviour's fields in the exact order the shipped assembly
  declares them. If IL2CPP strips a type or a field that the editor did serialize,
  every subsequent field in that object is read at the wrong offset. The first string
  it reaches then takes a garbage length and runs off the end of the file, which
  surfaces as a native crash in CachedReader::OutOfBoundsError on the Loading.Preload
  thread - no managed exception, no log line, the app simply vanishes at startup.

  Preserving the whole assembly costs a small amount of APK size and removes the
  possibility entirely. This assembly is one folder of study code, so the size is
  not worth the risk of a session dying on the headset.
-->
<linker>
  <assembly fullname="Assembly-CSharp" preserve="all"/>

  <!-- Engine classes created only from code. The rating stage builds its floor with
       CreatePrimitive(Cylinder), which attaches a CapsuleCollider; nothing in the saved
       scene carries one, so engine stripping removed the class and every cylinder logged
       "Can't add component because class 'CapsuleCollider' doesn't exist" at runtime.
       Harmless there because the collider is destroyed anyway, but preserved so a future
       primitive that does want its collider gets it. -->
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.CapsuleCollider" preserve="all"/>
    <type fullname="UnityEngine.MeshCollider" preserve="all"/>
  </assembly>
</linker>
